# Database — PostgreSQL via Supabase pooler
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Used to encrypt JWT tokens (min 32 chars)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# CRITICAL: no trailing whitespace or newline either. This value is concatenated
# directly into every sitemap <loc> and robots.txt Sitemap: line. A stray newline
# here silently corrupts the entire sitemap in production (incident 2026-09-10).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Supabase Storage (S3-compatible)
S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_BUCKET=media
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY
S3_REGION=ap-northeast-1

# WordPress Blog (headless CMS at wp.zuzy.co.il)
WP_API_URL=https://wp.zuzy.co.il/wp-json/wp/v2

# Shared secret for WP → Next.js revalidation webhook
REVALIDATION_SECRET=YOUR_REVALIDATION_SECRET_HERE

# Transactional email — Resend (@payloadcms/email-resend, src/payload.config.ts)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_ADDRESS=noreply@zuzy.co.il

# Recipient for form-submission notifications
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
